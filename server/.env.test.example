# Test overrides. Bun loads this on top of .env whenever NODE_ENV=test
# (`bun test`, `bun run db:test:prepare`, `bun run start:test`).
# Copy to .env.test and use the same credentials as .env, but the DB name must end in _test.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_powered_ims_test?schema=public"

# E2E servers run on their own ports so they never clash with `bun run dev`.
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:5174

# Users seeded by `bun run db:test:prepare` (reset on every E2E run).
E2E_ADMIN_EMAIL=admin@test.local
E2E_ADMIN_PASSWORD="admin-pass-123"
E2E_AGENT_EMAIL=agent@test.local
E2E_AGENT_PASSWORD="agent-pass-123"
