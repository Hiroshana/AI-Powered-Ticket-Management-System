PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_powered_ims?schema=public"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_AT_LEAST_32_CHARS"
BETTER_AUTH_URL=http://localhost:3000

# First admin, created by `bun run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="CHANGE_ME"
ADMIN_NAME=Admin

# Shared secret the email provider sends in the X-Inbound-Email-Secret header
# when POSTing to /api/inbound/email. Generate with: openssl rand -base64 32
# Leave empty to reject all inbound email.
INBOUND_EMAIL_SECRET=
